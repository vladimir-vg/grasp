# grasp's standard library.
#
# The **whole** library, not the part that works: a function this compiler has
# not got is still declared here, and calling one is `not implemented: <name>`
# rather than "there is no callable". The design lives in one place and the
# burn-down carries what is left of it.
#
# Every function is namespaced, and the namespace is the type family it belongs
# to: `string:length` and `array:length` are two functions rather than one asked
# to guess from its argument. `integer:` and `float:` do not merge — float
# semantics are not integer semantics, and `numeric`, when it arrives, is a
# third thing again.
#
# Access by position is `at`; access by key is `get`. The subject is positional
# and everything else is a keyword, except a binary operation over one type,
# which has no subject to set apart.
#
# A partial function derives no row rather than yielding an absent value:
# `dict:get` on a missing key has no answer, and a rule derives a row only where
# every step of its body has one. `array:index_of` and `array:min` are partial
# for the same reason; `slice` is not, clamping the way Python's does.
#
# What each function *means* is `semantics.md`; this is what it takes and what
# it gives back — and both halves are checked against the compiler rather than
# read alongside it: the shapes against `core::Builtin`'s signatures, the types
# by calling each variant at them and reading back what inference gives.

# -- boolean ------------------------------------------------------------------

boolean:not :: function
    (boolean) -> boolean

# -- integer ------------------------------------------------------------------

integer:abs :: function
    (i64) -> i64

integer:sign :: function
    (i64) -> i64

integer:pow :: function
    (i64, exponent: i64) -> i64

integer:min :: function
    (i64, i64) -> i64

integer:max :: function
    (i64, i64) -> i64

# -- float --------------------------------------------------------------------

float:abs :: function
    (f64) -> f64

float:floor :: function
    (f64) -> f64

float:ceil :: function
    (f64) -> f64

float:round :: function
    (f64) -> f64

float:sign :: function
    (f64) -> f64

float:sqrt :: function
    (f64) -> f64

float:pow :: function
    (f64, exponent: f64) -> f64

float:min :: function
    (f64, f64) -> f64

float:max :: function
    (f64, f64) -> f64

# -- string -------------------------------------------------------------------

string:length :: function
    (string) -> i64

string:concat :: function
    (string, string) -> string

string:lower :: function
    (string) -> string

string:upper :: function
    (string) -> string

string:trim :: function
    (string) -> string

string:ltrim :: function
    (string) -> string

string:rtrim :: function
    (string) -> string

string:at :: function
    (string, index: i64) -> string

string:slice :: function
    (string) -> string
    (string, stop: i64) -> string
    (string, start: i64) -> string
    (string, start: i64, stop: i64) -> string
    (string, step: i64) -> string
    (string, stop: i64, step: i64) -> string
    (string, start: i64, step: i64) -> string
    (string, start: i64, stop: i64, step: i64) -> string

string:starts_with :: function
    (string, prefix: string) -> boolean

string:ends_with :: function
    (string, suffix: string) -> boolean

string:contains :: function
    (string, sub: string) -> boolean

string:index_of :: function
    (string, sub: string) -> i64

string:replace :: function
    (string, from: string, to: string) -> string

string:split :: function
    (string, delimiter: string) -> array(string)

# -- array --------------------------------------------------------------------

array:length :: function
    (array(T)) -> i64

array:at :: function
    (array(T), index: i64) -> T

# Python's slice: negative indices count from the end, the bounds clamp rather
# than fail, and a negative step reverses. Three optional keywords, so eight
# ways to call it — `NONE` for a bound means "no bound here", whose end depends
# on the sign of the step and so is not a number.
array:slice :: function
    (array(T), start: i64 = NONE, stop: i64 = NONE, step: i64 = 1) -> array(T)

array:contains :: function
    (array(T), element: T) -> boolean

array:index_of :: function
    (array(T), element: T) -> i64

array:concat :: function
    (array(T), array(T)) -> array(T)

array:append :: function
    (array(T), element: T) -> array(T)

array:prepend :: function
    (array(T), element: T) -> array(T)

array:reverse :: function
    (array(T)) -> array(T)

# Ascending without the keyword. `desc:` is a boolean rather than a direction
# named by a string: grasp has no enum, and a two-valued choice spelled as text
# is one the type language cannot check.
array:sort :: function
    (array(T)) -> array(T)
    (array(T), desc: boolean) -> array(T)

array:distinct :: function
    (array(T)) -> array(T)

array:flatten :: function
    (array(array(T))) -> array(T)

array:min :: function
    (array(T)) -> T

array:max :: function
    (array(T)) -> T

# -- dict ---------------------------------------------------------------------

dict:length :: function
    (dict(K, V)) -> i64

dict:get :: function
    (dict(K, V), key: K) -> V

dict:has :: function
    (dict(K, V), key: K) -> boolean

dict:keys :: function
    (dict(K, V)) -> array(K)

dict:values :: function
    (dict(K, V)) -> array(V)

dict:entries :: function
    (dict(K, V)) -> array(record(key: K, value: V))

dict:from_entries :: function
    (array(record(key: K, value: V))) -> dict(K, V)

dict:without :: function
    (dict(K, V), keys: array(K)) -> dict(K, V)

dict:merge :: function
    (dict(K, V), dict(K, V)) -> dict(K, V)

# -- bytes --------------------------------------------------------------------
#
# Binary data, any length. A scalar: it orders lexicographically, so `min` folds
# it and it keys a dict. There is no bit-granular form and no fixed-size one.
#
# The encoding is in the **name**, never in a conversion, so which one a program
# means is written at every call. Only the readings that can fail are partial:
# every payload has a base64 and a hex spelling, but not every one is text, and
# not every string is base64.

bytes:length :: function
    (bytes) -> i64

bytes:concat :: function
    (bytes, bytes) -> bytes

# Bytewise, and partial: two payloads of different lengths have no answer.
bytes:and :: function
    (bytes, bytes) -> bytes

bytes:or :: function
    (bytes, bytes) -> bytes

bytes:xor :: function
    (bytes, bytes) -> bytes

bytes:to_base64 :: function
    (bytes) -> string

bytes:from_base64 :: function
    (string) -> bytes

bytes:to_hex :: function
    (bytes) -> string

bytes:from_hex :: function
    (string) -> bytes

bytes:to_string :: function
    (bytes) -> string

bytes:from_string :: function
    (string) -> bytes

# -- dynamic ------------------------------------------------------------------
#
# Any value, carrying what it is. `dynamic:of` is the way in and `d :: T` is the
# way out — and unlike a document, what a dynamic holds is an exact question: a
# dynamic holding a date is not a string, where a document holding
# "2024-01-15" is both.
#
# One function, because a top type needs one name that takes every type, which
# is what the type variable is for.

dynamic:of :: function
    (T) -> dynamic

# -- temporal -----------------------------------------------------------------
#
# `date`, `time`, `timestamp` and `interval`. A timestamp is always UTC — there
# are no timezones in grasp — which is what lets a day be exactly 86400 seconds
# and a span be one number.
#
# Parsing is **partial**, like every other reading that can fail to have an
# answer: `temporal:date("the fifteenth")` derives no row. So is construction
# from components, because not every triple of integers is a date.
#
# The three constructors are the one place a name means several functions and
# the **argument's type** picks between them: `temporal:date(s)` parses and
# `temporal:date(ts)` extracts. Everywhere else a name is one function.

temporal:date :: function
    (string) -> date
    (timestamp) -> date
    (year: i64, month: i64, day: i64) -> date

temporal:time :: function
    (string) -> time
    (timestamp) -> time
    (hour: i64, minute: i64, second: i64 = 0, microsecond: i64 = 0) -> time

temporal:timestamp :: function
    (string) -> timestamp
    (date: date, time: time) -> timestamp
    (epoch_microseconds: i64) -> timestamp

# The components, each over **either type that holds it** — so an instant needs
# no conversion written around it. Plural, because the answer is a count of them.

temporal:years :: function
    (date) -> i64
    (timestamp) -> i64

temporal:months :: function
    (date) -> i64
    (timestamp) -> i64

temporal:days :: function
    (date) -> i64
    (timestamp) -> i64

temporal:hours :: function
    (time) -> i64
    (timestamp) -> i64

temporal:minutes :: function
    (time) -> i64
    (timestamp) -> i64

temporal:seconds :: function
    (time) -> i64
    (timestamp) -> i64

temporal:microseconds :: function
    (time) -> i64
    (timestamp) -> i64

temporal:epoch_micros :: function
    (timestamp) -> i64

# A span of time, in microseconds. Every unit below a month converts into
# microseconds exactly — with no timezone a day is 86400 seconds — which is what
# lets one type hold all five. Months are the one that does not — a month has no
# length until it lands on a calendar — so grasp does not measure them at all.
#
# `+` and `-` do the rest: `ts - ts` is how far apart two instants are, and
# `ts + iv` shifts one. A date has no sub-day resolution, so shifting one
# truncates to whole days.

temporal:interval :: function
    (days: i64 = 0, hours: i64 = 0, minutes: i64 = 0,
     seconds: i64 = 0, microseconds: i64 = 0) -> interval

# The span in whole units of one size, named apart from the components because
# they answer a different question: `temporal:minutes(14:30)` is 30, and
# `temporal:total_minutes` of a hundred hours is 6000.

temporal:total_days :: function
    (interval) -> i64

temporal:total_hours :: function
    (interval) -> i64

temporal:total_minutes :: function
    (interval) -> i64

temporal:total_seconds :: function
    (interval) -> i64

temporal:total_microseconds :: function
    (interval) -> i64
